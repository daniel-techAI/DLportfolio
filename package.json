{
  "name": "daniel-laky-portfolio",
  "version": "0.1.0",
  "private": true,
  "description": "Daniel Laky's accessible, interactive mind-map portfolio.",
  "homepage": "https://daniel-techai.github.io/DLportfolio/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daniel-techAI/DLportfolio.git"
  },
  "bugs": {
    "url": "https://github.com/daniel-techAI/DLportfolio/issues"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npm run preview",
    "preview": "serve out -l 4173",
    "lint": "eslint src e2e next.config.ts playwright.config.ts vitest.config.mts eslint.config.mjs postcss.config.mjs",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:only": "playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "quality": "npm run check && npm run build && npm run test:e2e:only"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.2",
    "lucide-react": "^1.28.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
