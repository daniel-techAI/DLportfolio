# Absolute production origin, without a trailing slash. Until configured,
# metadata uses https://example.com as an explicit deployment placeholder.
NEXT_PUBLIC_SITE_URL=

# Leave blank for a root-domain deployment. For GitHub project pages use the
# repository name, for example /daniel-laky-portfolio.
NEXT_PUBLIC_BASE_PATH=

# Optional public identifiers. The application never injects analytics scripts,
# sets cookies, or stores consent. Configure these only when the host already
# provides the corresponding runtime through an appropriate consent flow.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Google Search Console HTML-tag verification token. Use only the
# token value, not the surrounding <meta> element.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
